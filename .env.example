# Copy to .env and fill in:  cp .env.example .env
# apps/api/src/config.ts is the only file that reads this (rule N1). It loads
# `.env.local` then `.env`, and a value exported in your shell always wins.
# Check it worked:  npm run doctor

# ---- Provider (rule N1: server-side only, never in the browser bundle) ----
# RailRadar Bearer key. Leave empty to stay in fixtures mode.
RAILRADAR_API_KEY=
# Base URL is unconfirmed (spike S6): docs use api.railradar.in.
RAILRADAR_BASE_URL=https://api.railradar.in

# fixtures = read saved JSON from fixtures/railradar and spend nothing (N6)
# live     = real provider calls, guarded by the monthly budget (N2)
PROVIDER_MODE=fixtures

# Which trains to fetch details for (one request each). Empty = in live mode,
# discover corridor trains from station boards, capped by MAX_TRAIN_DETAILS.
# Example: CORRIDOR_TRAINS=12301,12302,12004
CORRIDOR_TRAINS=
# Hard cap on train-details requests in one static load (section 3.3 plans ~12).
MAX_TRAIN_DETAILS=12

# ---- Database ----
# Empty -> embedded Postgres-compatible store in .data/pglite (local dev, CI).
# Set a postgres:// URL to use a managed Postgres (Neon / Supabase) instead.
# Local Postgres example: postgres://railtrack:railtrack@localhost:5432/railtrack
# Neon example (pooled host, note sslmode):
#   postgresql://user:pass@ep-xxx-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# `channel_binding=require` may stay in the string: it is dropped for you,
# because node-postgres does not implement channel binding.
# Same SQL and the same migrations either way (docs/SETUP.md).
DATABASE_URL=
# Neon shows a second string next to the direct one, named *_POOLED. Set either:
# DATABASE_URL_POOLED is only used when DATABASE_URL is blank, so pasting just
# the pooled one works too.
DATABASE_URL_POOLED=

# ---- Budget (rule N2, section 3.2) ----
MONTHLY_CAP=100
RESERVE=20
# Daily allowance = floor((remaining - reserve) / days left in the month)
BUDGET_TIMEZONE=Asia/Kolkata

# ---- Admin (section 13) ----
# Long random string. Empty disables admin routes entirely.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If admin routes answer "Admin routes are disabled. Set ADMIN_TOKEN." you forgot this.
ADMIN_TOKEN=

# ---- API / web ----
PORT=3001
HOST=0.0.0.0
# Comma separated list. The web dev server proxies /api, so same-origin in dev.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Scheduler: planned snapshots at 09:30 and 18:30 IST (two a day, see D-005).
SCHEDULER_ENABLED=false
DEFAULT_CORRIDOR=delhi-kanpur
