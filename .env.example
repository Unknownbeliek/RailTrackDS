# ---- Provider (rule N1: server-side only, never in the browser bundle) ----
# RailRadar Bearer key. Leave empty to stay in fixtures mode.
RAILRADAR_API_KEY=
# Base URL is unconfirmed (spike S6): docs use api.railradar.in.
RAILRADAR_BASE_URL=https://api.railradar.in

# fixtures = read saved JSON from fixtures/railradar and spend nothing (N6)
# live     = real provider calls, guarded by the monthly budget (N2)
PROVIDER_MODE=fixtures

# ---- Database ----
# Empty -> embedded Postgres-compatible store in .data/pglite (local dev, CI).
# Set a postgres:// URL to use a managed Postgres instead. Same SQL either way.
DATABASE_URL=

# ---- Budget (rule N2, section 3.2) ----
MONTHLY_CAP=100
RESERVE=20
# Daily allowance = floor((remaining - reserve) / days left in the month)
BUDGET_TIMEZONE=Asia/Kolkata

# ---- Admin (section 13) ----
# Long random string. Empty disables admin routes entirely.
ADMIN_TOKEN=

# ---- API / web ----
PORT=3001
HOST=0.0.0.0
# Comma separated list. The web dev server proxies /api, so same-origin in dev.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
DEFAULT_CORRIDOR=delhi-kanpur
